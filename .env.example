# Kalshi API key id from Account & security → API Keys.
# Leave blank to scan public markets only. Trading needs both values.
KALSHI_API_KEY_ID=

# Path to the PEM private key. Keep the file outside this repo.
# Example: /home/you/.kalshi/kalshi.key
KALSHI_PRIVATE_KEY_PATH=

# Install default is on, even when this variable is unset. Orders are refused.
# After install, the Finance Engineer sleeve sets this to 0.
# 0 still requires confirm:true on each order, and the caps below still apply.
KALSHI_SAFE_MODE=1

# Sleeve caps. Leave unset to keep the defaults: $71 sleeve, $2/idea,
# 15% of the sleeve in one market, $10 of new notional per UTC day.
# KALSHI_SLEEVE_DOLLARS=71
# KALSHI_MAX_DOLLARS_PER_IDEA=2
# KALSHI_MAX_SLEEVE_FRACTION=0.15
# KALSHI_MAX_DAILY_NOTIONAL=10
# KALSHI_LIKELY_SIZE_FRACTION=0.5
# KALSHI_TAKE_PROFIT_RETURN=0.5
# KALSHI_CUT_LOSS_RETURN=-0.4

# Optional. Production trade API. Demo: https://external-api.demo.kalshi.co/trade-api/v2
# KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
