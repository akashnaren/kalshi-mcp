# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# Trade tools stay unregistered until this is 0. Default is on.
# Finance Engineer sleeve, after install: set this to 0 and restart the host.
# confirm:true is still required. Caps still apply ($2 default, $15 hard max,
# 15% of the sleeve per market, 30% per corr_group, $10 new notional per UTC day).
KALSHI_SAFE_MODE=1
