KALSHI_API_KEY_ID=
# KALSHI_API_KEY_ID_PATH=
# If the key id env vars are unset, ~/.secrets/kalshi/key_id is used when that file exists.
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=
# If the PEM env vars are unset, ~/.secrets/kalshi/private.pem is used when that file exists.
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# Fleet default. Trade tools stay unregistered until this is 0.
# Only the Finance Engineer host sets 0. harness/SKILL.md owns that unlock.
# confirm:true is still required. Caps still apply ($2 default, $15 hard max,
# 15% of the sleeve per market, 30% per corr_group, $10 new notional per UTC day).
KALSHI_SAFE_MODE=1
# KALSHI_SLEEVE_DOLLARS=71
# KALSHI_DEFAULT_DOLLARS_PER_TRADE=2
# KALSHI_MAX_DOLLARS_PER_TRADE=15
# KALSHI_MAX_SLEEVE_FRACTION=0.15
# KALSHI_MAX_GROUP_FRACTION=0.30
# KALSHI_MAX_DAILY_NOTIONAL=10
