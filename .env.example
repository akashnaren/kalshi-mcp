KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=
# KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2

# Safe mode defaults to on when unset. Reads stay available, including list_open_orders.
# Set to 0 only when you intentionally want place_order, cancel_order, amend_order, or decrease_order.
# Those tools still require confirm: true on each call. Never set confirm for the operator.
KALSHI_SAFE_MODE=1
